# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Brevo (emails) — plan gratuito 300 mails/día, sin dominio propio.
# Setup: crear cuenta en https://app.brevo.com, verificar un single sender
# (email de Valen) desde Settings > Senders & IP, y generar una API key
# en Settings > SMTP & API > API Keys.
BREVO_API_KEY=xkeysib-your-api-key
FROM_EMAIL=valencosovschi@hotmail.com
FROM_NAME=COSOV.
ADMIN_EMAIL=valencosovschi@hotmail.com

# Google Sheets — sincronización automática de pedidos
# Setup: https://console.cloud.google.com → crear proyecto → habilitar "Google Sheets API"
# → crear Service Account → descargar JSON de credenciales → compartir el sheet con el email de la service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=cosov-sheets@tu-proyecto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
