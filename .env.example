# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (emails) — plan gratuito 3.000 mails/mes.
# Setup: crear cuenta en https://resend.com, agregar el dominio en Domains y
# cargar los registros DNS que pide, y después generar la key en API Keys.
# MAIL_FROM tiene que usar ese dominio verificado.
RESEND_API_KEY=re_tu-api-key
MAIL_FROM=COSOV. <pedidos@tudominio.com>
ADMIN_EMAIL=valencosovschi@hotmail.com

# Google Sheets — sincronización automática de pedidos
# Setup: https://console.cloud.google.com → crear proyecto → habilitar "Google Sheets API"
# → crear Service Account → descargar JSON de credenciales → compartir el sheet con el email de la service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=cosov-sheets@tu-proyecto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
